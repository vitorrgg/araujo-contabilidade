---
import Layout from '~/layouts/Layout.astro';
import HomeHero from '~/components/home/HomeHero.astro';
import Pillars from '~/components/home/Pillars.astro';
import Differentials from '~/components/home/Differentials.astro';
import PjFront from '~/components/home/PjFront.astro';
import CertificadoBand from '~/components/CertificadoBand.astro';
import ContactSection from '~/components/home/ContactSection.astro';
import { site } from '~/config/site';

/*
 * Home institucional. Sem preço, de propósito: a home tem que sustentar tanto
 * o PJ que veio do anúncio quanto a empresa que está avaliando due diligence.
 * Preço vive só em /pj.
 *
 * Ordem: quem somos e pra quem (hero rotativo) → o que fazemos (3 pilares) →
 * por que nós → a oferta de entrada (PJ) → contato.
 */
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  areaServed: 'BR',
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressCountry: 'BR',
  },
  knowsAbout: [
    'Assessoria contábil e fiscal',
    'Departamento pessoal',
    'Abertura e legalização de empresas',
    'Due diligence contábil',
    'Projeções financeiras',
    'Contabilidade para PJ',
    'Certificado digital e-CPF e e-CNPJ',
  ],
};
---

<Layout>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(businessSchema)}
  />
  <HomeHero />
  <Pillars />
  <Differentials />
  <PjFront />
  <CertificadoBand />
  <ContactSection />
</Layout>

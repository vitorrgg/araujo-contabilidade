---
import { differentials } from '~/config/site';
---

<section class="brand-surface-ink ui-block">
  <div class="ui-section">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.25fr] lg:gap-20">
      <header class="lg:sticky lg:top-28 lg:self-start">
        <p class="brand-eyebrow text-sm">{differentials.eyebrow}</p>
        <span class="brand-rule mt-5"></span>
        <h2 class="ui-title mt-5">{differentials.title}</h2>
      </header>

      <dl class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
        {differentials.items.map(({ icon, title, text }) => (
          <div>
            <span class="ui-icon-box" aria-hidden="true">
              <span class={icon}></span>
            </span>
            <dt class="mt-5 text-lg font-semibold text-white">{title}</dt>
            <dd class="brand-ink-soft mt-2 text-[0.95rem] leading-relaxed">
              {text}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

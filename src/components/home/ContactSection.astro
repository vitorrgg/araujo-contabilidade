---
import { contact, site, waLink } from '~/config/site';
---

<section id="contato" class="brand-surface-alt ui-block scroll-mt-24">
  <div class="ui-section">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <p class="brand-eyebrow text-sm">{contact.eyebrow}</p>
        <span class="brand-rule mt-5"></span>
        <h2 class="ui-title mt-5">{contact.title}</h2>
        <p class="ui-lead max-w-lg">{contact.lead}</p>
        <a
          href={waLink()}
          target="_blank"
          rel="noopener"
          class="brand-btn ui-btn-lg mt-8"
        >
          <span class="i-lucide-message-circle"></span>
          {contact.ctaLabel}
        </a>
        <p class="brand-ink-muted mt-4 text-sm">{contact.note}</p>
      </div>

      <dl class="brand-card divide-y self-start">
        <div class="flex items-start gap-4 p-6">
          <span class="ui-icon-box" aria-hidden="true">
            <span class="i-lucide-message-circle"></span>
          </span>
          <div>
            <dt class="brand-ink font-semibold">WhatsApp e telefone</dt>
            <dd class="mt-1 text-[0.95rem]">
              <a href={waLink()} target="_blank" rel="noopener" class="brand-link">
                {site.phoneDisplay}
              </a>
              <span class="brand-ink-muted"> · </span>
              <a href={`tel:${site.phone}`} class="brand-link">ligar</a>
            </dd>
          </div>
        </div>
        <div class="flex items-start gap-4 p-6">
          <span class="ui-icon-box" aria-hidden="true">
            <span class="i-lucide-mail"></span>
          </span>
          <div>
            <dt class="brand-ink font-semibold">E-mail</dt>
            <dd class="mt-1 text-[0.95rem]">
              <a href={`mailto:${site.email}`} class="brand-link">
                {site.email}
              </a>
            </dd>
          </div>
        </div>
        <div class="flex items-start gap-4 p-6">
          <span class="ui-icon-box" aria-hidden="true">
            <span class="i-lucide-map-pin"></span>
          </span>
          <div>
            <dt class="brand-ink font-semibold">Atendimento</dt>
            <dd class="brand-ink-soft mt-1 text-[0.95rem]">
              {site.city} — e remoto para todo o Brasil
            </dd>
          </div>
        </div>
      </dl>
    </div>
  </div>
</section>

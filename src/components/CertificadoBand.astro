---
import { certificado } from '~/config/certificado';

/*
 * Faixa de chamada pro certificado, usada na home e no fim de /servicos.
 *
 * Sem foto de propósito: na home ela vem logo depois da faixa do PJ, que já é
 * editorial com imagem. Dois blocos foto+texto seguidos leem como repetição —
 * aqui a marca sustenta sozinha, com o azul-marinho e os dois cartões.
 */
---

<section class="brand-surface ui-block">
  <div class="ui-section">
    <div
      class="brand-surface-ink relative overflow-hidden px-7 py-12 md:px-12
      md:py-14"
      style="border-radius: calc(var(--brand-radius) * 2)"
    >
      <div
        class="pointer-events-none absolute -left-24 -bottom-28 size-72
        rounded-full opacity-20 blur-3xl"
        style="background-color: var(--brand-accent)"
        aria-hidden="true"
      >
      </div>

      <div class="relative grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
        <div>
          <p class="brand-eyebrow text-sm">{certificado.band.eyebrow}</p>
          <span class="brand-rule mt-5"></span>
          <h2 class="ui-title mt-5">{certificado.band.title}</h2>
          <p class="ui-lead max-w-lg">{certificado.band.lead}</p>
          <a href={certificado.band.ctaHref} class="brand-btn ui-btn mt-8">
            {certificado.band.ctaLabel}
            <span class="i-lucide-arrow-right" aria-hidden="true"></span>
          </a>
        </div>

        <dl class="grid gap-4 self-center sm:grid-cols-2">
          {certificado.band.items.map(({ title, text }) => (
            <div class="brand-card p-6">
              <dt class="brand-display text-2xl font-bold text-white">
                {title}
              </dt>
              <dd class="brand-ink-soft mt-2.5 text-[0.95rem] leading-relaxed">
                {text}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

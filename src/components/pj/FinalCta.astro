---
import { pj, waLink } from "~/config/site";

const finalCta = pj.finalCta;
---

<section class="brand-surface ui-block">
  <div class="ui-section">
    <div
      class="brand-surface-ink relative overflow-hidden px-7 py-14
      text-center md:px-12 md:py-16"
      style="border-radius: calc(var(--brand-radius) * 2)"
    >
      <div
        class="pointer-events-none absolute -right-24 -top-24 size-72
        rounded-full opacity-20 blur-3xl"
        style="background-color: var(--brand-accent)"
        aria-hidden="true"
      >
      </div>

      <h2 class="ui-title relative">{finalCta.title}</h2>
      <p class="ui-lead relative mx-auto max-w-xl">{finalCta.lead}</p>
      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        class="brand-btn ui-btn-lg relative mt-8"
      >
        <span class="i-lucide-message-circle"></span>
        {finalCta.ctaLabel}
      </a>
      <p class="brand-ink-muted relative mt-4 text-sm">{finalCta.note}</p>
    </div>
  </div>
</section>

---
import SectionHeading from '~/components/SectionHeading.astro';
import Faq from '~/components/Faq.vue';

/*
 * O acordeão é uma island Vue, mas as perguntas também vão em JSON-LD:
 * é o que faz a resposta aparecer na busca e ser lida por LLM, que hoje é
 * canal de aquisição tanto quanto o Google.
 *
 * Genérico por props: /pj e /certificado-digital usam o mesmo bloco com
 * conjuntos de perguntas diferentes.
 */
export type Props = {
  eyebrow?: string;
  title: string;
  items: Array<{ q: string; a: string }>;
  id?: string;
};

const { eyebrow, title, items, id = 'duvidas' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<section id={id} class="brand-surface ui-block scroll-mt-24">
  <div class="ui-section">
    <SectionHeading eyebrow={eyebrow} title={title} />
    <Faq client:visible items={items} />
  </div>
</section>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(faqSchema)}
/>
